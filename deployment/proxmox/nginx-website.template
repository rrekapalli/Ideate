server {
    listen 80 default_server;
    listen [::]:80 default_server;
    include /etc/nginx/snippets/ideate-ssl.conf;
    server_name {{DOMAIN}};

    root {{APP_ROOT}};
    index index.html;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_min_length 1000;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; script-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'" always;

    expires -1;

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location = /sitemap.xml {
        return 404;
    }

    location /health {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    location ^~ /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location ~* \.(png|svg|ico|woff2?)$ {
        expires 30d;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri.html $uri/index.html $uri/ =404;
    }
}
