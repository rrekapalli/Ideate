FROM pgvector/pgvector:pg16

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        flex \
        bison \
        git \
        postgresql-server-dev-16 \
        libreadline-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN git clone --depth 1 --branch PG16/v1.5.0 https://github.com/apache/age.git age \
    || git clone --depth 1 --branch v1.5.0 https://github.com/apache/age.git age \
    && cd age \
    && make PG_CONFIG=/usr/bin/pg_config \
    && make install PG_CONFIG=/usr/bin/pg_config \
    && cd / \
    && rm -rf /tmp/age

RUN apt-get purge -y --auto-remove build-essential git postgresql-server-dev-16 \
    && rm -rf /var/lib/apt/lists/*

USER postgres
