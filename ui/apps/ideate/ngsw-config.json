{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationRequestStrategy": "freshness",
  "navigationUrls": ["/**", "!/**/*.*", "!/v1/**"],
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/main*.js",
          "/polyfills*.js",
          "/scripts*.js"
        ]
      }
    },
    {
      "name": "lazy-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/chunk-*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**"]
      }
    }
  ]
}
